# Optional — Banglish parsing falls back to a keyword heuristic without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Address the BROWSER uses to reach the API (baked into the web bundle at build).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Default is a multi-arch PostGIS build. On x86 you can use the official image:
#   POSTGIS_IMAGE=postgis/postgis:17-3.5
POSTGIS_IMAGE=imresamu/postgis:17-3.5
